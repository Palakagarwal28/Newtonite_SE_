# Copy to .env for local dev. Never commit real credentials.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/newtonite?schema=public"
PORT="3001"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="newtonite"
POSTGRES_PORT="5432"
VITE_API_URL="http://localhost:3001"

# Auth (M1.1). Generate a real secret for any shared env, e.g. `openssl rand -base64 48`.
# Minimum: 1+ chars in dev/test; required in production (app throws without it).
JWT_SECRET="change-me-to-a-long-random-secret-min-32-chars"
JWT_EXPIRES_IN="12h"
# bcrypt cost factor (10 = default; lower only for faster tests).
BCRYPT_ROUNDS="10"

# Seed / demo bootstrap (dev only, never production secrets).
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="Admin123!"
SEED_MANAGER_EMAIL="manager.alpha@example.com"
SEED_MANAGER_PASSWORD="Manager123!"
SEED_MEMBER_EMAIL="member.alpha@example.com"
SEED_MEMBER_PASSWORD="Member123!"
SEED_OUTSIDER_EMAIL="outsider@example.com"
SEED_OUTSIDER_PASSWORD="Outsider123!"
